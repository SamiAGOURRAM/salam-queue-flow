{
  "name": "@queuemed/chat-api",
  "version": "0.1.0",
  "description": "QueueMed AI chatbot backend — Vercel AI SDK agent over the QueueMed MCP tools, with Supabase-JWT auth guardrails",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ai": "^5.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.10.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
