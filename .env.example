# ───────────────────────────────────────────────────────────────────────────
# QueueMed environment configuration
# Copy to `.env` and fill in. Three services read from here:
#   web        (frontend)  — VITE_* vars, inlined at build time
#   mcp-server (backend)   — SUPABASE_* (server-side, RBAC tool access)
#   chat-api   (backend)   — LLM + MCP_SERVER_URL (the AI chatbot agent)
# ───────────────────────────────────────────────────────────────────────────

# ── Frontend (web) ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here
# URL of the chat-api backend the chat widget talks to.
# Local: http://localhost:8787 | Prod: https://chat-api.your-domain.com
VITE_CHAT_API_URL=http://localhost:8787
# Set to "true" once the notification provider (Twilio) is wired as Supabase
# Edge Function secrets. When false/absent, queue notifications (SMS, WhatsApp,
# email) are silently skipped instead of attempting delivery and logging 5xx errors.
VITE_SMS_ENABLED=false
# Optional feature flags
VITE_USE_SERVICE_LAYER=true
VITE_USE_API_LAYER=false
VITE_APP_VERSION=2.0.0

# ── MCP server (backend) ────────────────────────────────────────────────────
# Server-side Supabase access for tool execution + JWT validation.
# Use the SERVICE ROLE key (Dashboard > Settings > API, or `supabase status`).
# For local Supabase from Docker: SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Anon/publishable key — REQUIRED so tools query under the caller's JWT and
# Postgres RLS enforces at the DB level (service key is used only to validate JWTs).
SUPABASE_ANON_KEY=your-publishable-anon-key-here
# Port for the MCP Streamable HTTP transport (default 3001).
SERVER_PORT=3001

# ── chat-api (backend) — the AI chatbot agent ───────────────────────────────
CHAT_API_PORT=8787
# Where chat-api reaches the MCP server (forwards the user's JWT for guardrails).
# Local: http://localhost:3001/mcp | Docker: http://mcp-server:3001/mcp
MCP_SERVER_URL=http://localhost:3001/mcp
# LLM provider: groq | openai | anthropic | mock.
#  - `mock`: deterministic, zero-token model that still drives the REAL MCP tools,
#    streaming and cards — use for development when provider quota is spent.
#  - Without a key, a provider also degrades to a simple text-only mock responder.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# Comma-separated allowed origins for the chat widget ("*" for any).
CHAT_API_CORS_ORIGINS=*

# ── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Supabase Edge Function secrets (set in Supabase Dashboard, not here) ──────
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1234567890
# SENTRY_DSN=...
