# syntax=docker/dockerfile:1
#
# PRODUCTION image for the chat-api agent backend.
# Multi-stage: compile @queuemed/chat-api to dist, then run with node.

# ---- build stage ----
FROM node:20-bookworm-slim AS build
ENV CI=true
RUN corepack enable
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @queuemed/chat-api build

# ---- runtime stage ----
FROM node:20-bookworm-slim AS runtime
ENV NODE_ENV=production \
    CHAT_API_PORT=8787
RUN corepack enable
WORKDIR /app

COPY --from=build /app /app

EXPOSE 8787
CMD ["node", "apps/chat-api/dist/index.js"]
